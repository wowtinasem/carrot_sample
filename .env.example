# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# VITE_KAKAO_MAP_APPKEY: Optional Kakao Maps JavaScript API key for native SDK map rendering.
VITE_KAKAO_MAP_APPKEY="MY_KAKAO_MAP_JS_KEY"

# KAKAO_REST_API_KEY: Optional Kakao Local REST API key for server-side place search.
KAKAO_REST_API_KEY="MY_KAKAO_REST_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# SESSION_SECRET: Secret key used to sign customer & staff session cookies.
SESSION_SECRET="change-this-in-production"

# STAFF_DEFAULT_PASSCODE: Initial passcode for seeded staff login (staff1).
STAFF_DEFAULT_PASSCODE="icon2026"

# ADMIN_DEFAULT_PASSCODE: Initial passcode for seeded manager login (manager).
ADMIN_DEFAULT_PASSCODE="admin2026"

# PUBLIC_COUPON_MODE: Optional override ("preview" | "public"). When campaign dates are empty,
# preview allows test coupon issuance while public displays "쿠폰 준비 중".
PUBLIC_COUPON_MODE="preview"
